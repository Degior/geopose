{
  "network": "TimmUnet",
  "encoder_params": {
    "encoder": "tf_efficientnetv2_l_in21k",
    "drop_path_rate": 0.2
  },
  "optimizer": {
    "train_bs": 1,
    "val_bs": 1,
    "type": "AdamW",
    "weight_decay": 0.01,
    "learning_rate": 3e-06,
    "schedule": {
      "type": "cosine",
      "mode": "step",
      "epochs": 15,
      "params": {
        "T_max": 50000,
        "eta_min": 5e-06
      }
    }
  },
  "losses": [
    {
      "name": "scale",
      "type": "MSEScaleLossCalculator",
      "weight": 20.0,
      "display": true,
      "params": {}
    },
    {
      "name": "angle",
      "type": "MSEAngleLossCalculator",
      "weight": 2.0,
      "display": true,
      "params": {}
    },
    {
      "name": "agl",
      "type": "NoNaNR2AGLLossCalculator",
      "weight": 1.0,
      "display": true,
      "params": {}
    },
    {
      "name": "mag",
      "type": "NoNaNR2MAGLossCalculator",
      "weight": 1.0,
      "display": true,
      "params": {}
    },
    {
      "name": "fagl",
      "type": "FocalAGLLossCalculator",
      "weight": 0.05,
      "display": true,
      "params": {}
    },
    {
      "name": "fmag",
      "type": "FocalMAGLossCalculator",
      "weight": 0.05,
      "display": true,
      "params": {}
    },
    {
      "name": "huber_agl",
      "type": "HuberAGLLossCalculator",
      "weight": 0.1,
      "display": true,
      "params": {
        "delta": 1.0,
        "max_height": 250.0
      }
    }
  ]
}
